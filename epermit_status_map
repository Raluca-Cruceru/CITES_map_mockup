  aboutText1:"Versión 1 de un componente de mapa reutilizable para el sitio web. Las categorías, colores y campos son provisionales y debe confirmarlos la Secretaría.",
  aboutText2:"La vista de tabla ofrece la misma información para lectores de pantalla y navegación con teclado. Las fronteras se sustituirán por fronteras aprobadas por la ONU antes de la publicación.",
  disclaimer:"Las fronteras y los nombres que figuran en este mapa y las denominaciones utilizadas en él no implican su apoyo o aceptación oficial por las Naciones Unidas.",
  mapErr:"No se pudieron cargar las fronteras. La vista de tabla muestra la misma información.",
  mapLabel:"Mapa mundial del estado de los permisos electrónicos por país",count:"{n} países"}
};

/* ---- state ---- */
var state = {lang:"en", view:"map", active:new Set(STATUS_ORDER), q:"", sel:null, sortKey:"name", sortDir:1};
try{ var L=localStorage.getItem("epmap-lang"); if(T[L]) state.lang=L; }catch(e){}

function parseCSV(text){
  var lines=text.trim().split(/\r?\n/), head=lines.shift().split(",");
  return lines.map(function(line){
    var parts=line.split(","), o={};
    head.forEach(function(h,i){ o[h]= i===head.length-1 ? parts.slice(i).join(",") : (parts[i]||""); });
    return o;
  });
}
var rows = parseCSV(CSV);
var byIso = {}; rows.forEach(function(r){ byIso[r.iso3]=r; });

var topoNames = {};
function t(k){ return (T[state.lang][k]!==undefined) ? T[state.lang][k] : T.en[k]; }
var dn = {};
function cname(iso3){
  var iso2 = ISO2[iso3];
  if(iso2 && typeof Intl!=="undefined" && Intl.DisplayNames){
    try{ dn[state.lang]=dn[state.lang]||new Intl.DisplayNames([state.lang],{type:"region"}); var n=dn[state.lang].of(iso2); if(n && n!==iso2) return n; }catch(e){}
  }
  return topoNames[iso3] || iso3;
}
function color(status){ return status && STATUS_VAR[status] ? "var("+STATUS_VAR[status]+")" : "var(--land-empty)"; }
function matches(r){
  if(!r) return false;
  if(!state.active.has(r.status)) return false;
  if(state.q){ var n=cname(r.iso3).toLowerCase(); if(n.indexOf(state.q)<0 && r.iso3.toLowerCase()!==state.q) return false; }
  return true;
}
function esc(s){ return String(s).replace(/[&<>"]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c];}); }

/* ---- text ---- */
function applyText(){
  document.documentElement.lang = state.lang;
  document.querySelectorAll("[data-i]").forEach(function(el){ el.textContent=t(el.getAttribute("data-i")); });
  document.getElementById("search").placeholder=t("search");
  document.getElementById("search").setAttribute("aria-label",t("search"));
  document.getElementById("map").setAttribute("aria-label",t("mapLabel"));
  document.querySelectorAll(".lang button").forEach(function(b){ b.setAttribute("aria-pressed", String(b.dataset.lang===state.lang)); });
  document.getElementById("csvSample").textContent = CSV.split("\n").slice(0,6).join("\n")+"\n…";
}

/* ---- chips ---- */
function renderChips(){
  var box=document.getElementById("chips"); box.innerHTML="";
  STATUS_ORDER.forEach(function(s){
    var n=rows.filter(function(r){return r.status===s;}).length;
    var b=document.createElement("button");
    b.type="button"; b.className="chip"; b.id="chip-"+s;
    b.setAttribute("aria-pressed", String(state.active.has(s)));
    b.innerHTML='<span class="sw" style="background:'+color(s)+'"></span>'+esc(t("s_"+s))+' <span class="n">'+n+'</span>';
    b.addEventListener("click",function(){
      if(state.active.has(s)) state.active.delete(s); else state.active.add(s);
      if(state.active.size===0) STATUS_ORDER.forEach(function(x){state.active.add(x);});
      renderChips(); refresh();
    });
    box.appendChild(b);
  });
}

/* ---- panel ---- */
function renderPanel(){
  var p=document.getElementById("panel"), iso=state.sel;
  if(!iso){ p.innerHTML='<h2>'+esc(t("pickTitle"))+'</h2><p class="hint">'+esc(t("pickHint"))+'</p>'; return; }
  var r=byIso[iso], html='<h2>'+esc(cname(iso))+'</h2>';
  if(!r){ html+='<span class="pill" style="background:var(--muted)">'+esc(t("s_NONE"))+'</span><p class="hint">'+esc(t("noInfo"))+'</p>'; p.innerHTML=html; return; }
  html+='<span class="pill" style="background:'+color(r.status)+'">'+esc(t("s_"+r.status))+'</span>';
  html+='<dl><dt>'+esc(t("system"))+'</dt><dd>'+esc(r.system||t("none"))+'</dd>';
  html+='<dt>'+esc(t("since"))+'</dt><dd>'+esc(r.since||t("none"))+'</dd>';
  html+='<dt>'+esc(t("epix"))+'</dt><dd>'+esc(r.epix==="yes"?t("yes"):t("no"))+'</dd></dl>';
  if(r.note) html+='<p class="note">'+esc(r.note)+'</p>';
  p.innerHTML=html;
}

/* ---- table ---- */
function renderTable(){
  var tb=document.getElementById("tbody");
  var list=rows.filter(matches).map(function(r){ return {r:r,name:cname(r.iso3),status:STATUS_ORDER.indexOf(r.status),system:r.system,since:r.since,epix:r.epix}; });
  var k=state.sortKey, d=state.sortDir;
  list.sort(function(a,b){ var x=a[k],y=b[k]; if(x===y) return a.name.localeCompare(b.name,state.lang); if(x===""||x===undefined) return 1; if(y===""||y===undefined) return -1; return (typeof x==="number"? x-y : String(x).localeCompare(String(y),state.lang))*d; });
  tb.innerHTML=list.map(function(o){
    var r=o.r;
    return '<tr class="row" tabindex="0" data-iso="'+r.iso3+'"><td>'+esc(o.name)+'</td><td><span class="dot" style="background:'+color(r.status)+'"></span>'+esc(t("s_"+r.status))+'</td><td>'+esc(r.system||t("none"))+'</td><td class="num">'+esc(r.since||t("none"))+'</td><td>'+esc(r.epix==="yes"?t("yes"):t("no"))+'</td></tr>';
  }).join("");
  document.querySelectorAll("th button").forEach(function(b){ if(b.dataset.sort===k) b.setAttribute("data-dir", d>0?"↑":"↓"); else b.removeAttribute("data-dir"); });
}
document.getElementById("tbody").addEventListener("click",function(e){ var tr=e.target.closest("tr.row"); if(tr){ select(tr.dataset.iso); setView(paths?"map":"table"); } });
document.getElementById("tbody").addEventListener("keydown",function(e){ if(e.key==="Enter"){ var tr=e.target.closest("tr.row"); if(tr){ select(tr.dataset.iso); setView(paths?"map":"table"); } } });
document.querySelectorAll("th button").forEach(function(b){ b.addEventListener("click",function(){ if(state.sortKey===b.dataset.sort) state.sortDir*=-1; else {state.sortKey=b.dataset.sort; state.sortDir=1;} renderTable(); }); });

/* ---- map ---- */
var paths=null, zoom=null, svgSel=null, gSel=null, pathGen=null, features=[];
function decodeTopo(topo, objName){
  var tr=topo.transform, arcs=topo.arcs.map(function(arc){
    var x=0,y=0; return arc.map(function(p){
      if(tr){ x+=p[0]; y+=p[1]; return [x*tr.scale[0]+tr.translate[0], y*tr.scale[1]+tr.translate[1]]; }
      return [p[0],p[1]];
    });
  });
  function arc(i){ var a = i<0 ? arcs[~i].slice().reverse() : arcs[i].slice(); return a; }
  function ring(ids){ var pts=[]; ids.forEach(function(i,k){ var a=arc(i); if(k>0) a.shift(); pts=pts.concat(a); }); return pts; }
  function poly(rs){ return rs.map(ring); }
  return topo.objects[objName].geometries.map(function(g){
    var geom=null;
    if(g.type==="Polygon") geom={type:"Polygon",coordinates:poly(g.arcs)};
    else if(g.type==="MultiPolygon") geom={type:"MultiPolygon",coordinates:g.arcs.map(poly)};
    return {type:"Feature",id:g.id,properties:g.properties||{},geometry:geom};
  }).filter(function(f){ return f.geometry; });
}
function initMap(){
  var box=document.getElementById("mapbox");
  try{
    if(!window.d3 || !window.Datamap || !Datamap.prototype.worldTopo) throw new Error("no lib");
    var topo=Datamap.prototype.worldTopo, objName=Object.keys(topo.objects)[0];
    features=decodeTopo(topo,objName).filter(function(f){ return f.id!=="ATA"; });
    features.forEach(function(f){ if(f.properties && f.properties.name) topoNames[f.id]=f.properties.name; });
  }catch(e){
    box.innerHTML='<div class="maperr">'+esc(t("mapErr"))+'</div>';
    return false;
  }
  var W=960,H=470;
  var proj=d3.geoNaturalEarth1().fitExtent([[8,8],[W-8,H-8]],{type:"FeatureCollection",features:features});
  pathGen=d3.geoPath(proj);
  svgSel=d3.select("#map");
  gSel=svgSel.append("g");
  var tip=document.getElementById("tip");
  paths=gSel.selectAll("path").data(features).join("path")
    .attr("class",function(f){ return "c"+(byIso[f.id]?" has":""); })
    .attr("d",pathGen)
    .attr("tabindex",function(f){ return byIso[f.id]?0:null; })
    .attr("role",function(f){ return byIso[f.id]?"button":null; })
    .on("mousemove",function(ev,f){
      var r=byIso[f.id], rect=box.getBoundingClientRect();
      tip.innerHTML='<b>'+esc(cname(f.id))+'</b><br>'+esc(r?t("s_"+r.status):t("s_NONE"));
      tip.hidden=false;
      var x=ev.clientX-rect.left+12, y=ev.clientY-rect.top+12;
      if(x+tip.offsetWidth>rect.width-4) x=ev.clientX-rect.left-tip.offsetWidth-12;
      if(y+tip.offsetHeight>rect.height-4) y=ev.clientY-rect.top-tip.offsetHeight-12;
      tip.style.left=x+"px"; tip.style.top=y+"px";
    })
    .on("mouseleave",function(){ tip.hidden=true; })
    .on("click",function(ev,f){ select(f.id); })
    .on("keydown",function(ev,f){ if(ev.key==="Enter"||ev.key===" "){ ev.preventDefault(); select(f.id); } });
  zoom=d3.zoom().scaleExtent([1,8]).translateExtent([[0,0],[W,H]]).on("zoom",function(ev){ gSel.attr("transform",ev.transform); tip.hidden=true; });
  svgSel.call(zoom).on("dblclick.zoom",null);
  document.getElementById("zin").onclick=function(){ svgSel.transition().duration(250).call(zoom.scaleBy,1.6); };
  document.getElementById("zout").onclick=function(){ svgSel.transition().duration(250).call(zoom.scaleBy,1/1.6); };
  document.getElementById("zreset").onclick=function(){ svgSel.transition().duration(250).call(zoom.transform,d3.zoomIdentity); };
  return true;
}
function styleMap(){
  if(!paths) return;
  paths.attr("fill",function(f){ var r=byIso[f.id]; return r ? color(r.status) : "var(--land-empty)"; })
    .classed("dim",function(f){ var r=byIso[f.id]; if(!r) return !!state.q; return !matches(r); })
    .classed("hit",function(f){ return !!state.q && matches(byIso[f.id]); })
    .classed("sel",function(f){ return f.id===state.sel; })
    .attr("aria-label",function(f){ var r=byIso[f.id]; return r? cname(f.id)+": "+t("s_"+r.status) : null; });
  paths.filter(function(f){ return f.id===state.sel; }).raise();
}

function select(iso){ state.sel=iso; renderPanel(); styleMap(); }
function setView(v){
  state.view=v;
  document.getElementById("mapView").hidden = v!=="map";
  document.getElementById("tableView").hidden = v!=="table";
  document.querySelectorAll(".views button").forEach(function(b){ b.setAttribute("aria-pressed", String(b.dataset.view===v)); });
}
function refresh(){ styleMap(); renderTable(); }

document.querySelectorAll(".views button").forEach(function(b){ b.addEventListener("click",function(){ setView(b.dataset.view); }); });
document.querySelectorAll(".lang button").forEach(function(b){ b.addEventListener("click",function(){
  state.lang=b.dataset.lang; try{ localStorage.setItem("epmap-lang",state.lang); }catch(e){}
  applyText(); renderChips(); renderPanel(); refresh();
}); });
document.getElementById("search").addEventListener("input",function(e){ state.q=e.target.value.trim().toLowerCase(); refresh(); });
document.getElementById("search").addEventListener("keydown",function(e){
  if(e.key==="Enter"){ var hit=rows.filter(matches)[0]; if(hit) select(hit.iso3); }
});
document.getElementById("copyCsv").addEventListener("click",function(){
  var btn=this;
  function done(ok){ btn.textContent= ok? t("copied") : t("copyFail"); setTimeout(function(){ btn.textContent=t("copy"); },1800); }
  try{ navigator.clipboard.writeText(CSV).then(function(){done(true);},function(){ selectPre(); done(false); }); }
  catch(e){ selectPre(); done(false); }
});
function selectPre(){ var pre=document.getElementById("csvSample"); var r=document.createRange(); r.selectNodeContents(pre); var s=window.getSelection(); s.removeAllRanges(); s.addRange(r); }

applyText();
renderChips();
var ok=initMap();
renderPanel();
setView(ok? "map" : "table");
if(!ok){ document.getElementById("view-map").disabled=true; }
refresh();
})();
</script>

</body></html>
